# Copy to `.env` next to docker-compose.yml and edit.
#   cp .env.docker.example .env

# Public address people visit. Strongly recommended — it is what the API puts
# in the shareable link. No trailing slash.
SHH_BASE_URL=https://shh.example.org

# Friendly label shown by /api/v1/info. Optional.
#SHH_INSTANCE_NAME=Our team's shh

# Bearer tokens for /api/v1, comma separated. Leave unset for an open API
# (same posture as the web form). Generate: openssl rand -base64 32
#SHH_API_TOKENS=

# Secrets one IP may create per hour. 0 disables.
#SHH_CREATE_RATE_LIMIT=60

# Reverse proxies in front of the app. 1 for a single proxy (the default),
# 2 behind Cloudflare + your own proxy, 0 if not proxied at all.
# Getting this right is what keeps the rate limits from being bypassable.
#SHH_TRUSTED_PROXY_HOPS=1

# Trusted single-value client-IP header, e.g. CF-Connecting-IP. Optional.
#SHH_CLIENT_IP_HEADER=

# Host port for the loopback bind in docker-compose.yml.
#SHH_HOST_PORT=3011

# Only for the optional Caddy overlay (docker-compose.caddy.yml).
#SHH_DOMAIN=shh.example.org

# Uncomment `user:` in docker-compose.yml if ./data is owned by another uid.
#PUID=1000
#PGID=1000
