# Copy to `.env.deploy` and fill in. Used by setup-pi.sh and deploy.sh.
#   cp .env.deploy.example .env.deploy

# SSH user on the Pi. Also determines the deploy path (/home/<PI_USER>/shh)
# that gets substituted into the nginx config.
PI_USER=pi

# Hostname or IP of the Pi. Required — no default.
PI_HOST=192.0.2.10

# Public domain that resolves to the Pi. Required — used for server_name and
# for the Let's Encrypt certificate.
DOMAIN_NAME=shh.example.com
