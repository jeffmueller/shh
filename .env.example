NODE_ENV=production

# ─── Instance identity ───────────────────────────────────────────────────
# Public origin of this instance. Used to build the shareable /s/<id>#<key>
# URL returned by POST /api/v1/secrets, since an API client has no browser
# window.location to read.
#
# Read at runtime, so changing it in the systemd EnvironmentFile and restarting
# the service is enough — no rebuild needed.
SHH_BASE_URL=https://shh.example.com

# Legacy alias for the same value, checked only if SHH_BASE_URL is unset.
# Kept for existing deployments; prefer SHH_BASE_URL for new ones.
NEXT_PUBLIC_BASE_URL=https://shh.example.com

# Friendly name reported by GET /api/v1/info, so a client configured with this
# server address can label it. Defaults to the host of SHH_BASE_URL.
# SHH_INSTANCE_NAME=Jeff's shh

# ─── Storage ─────────────────────────────────────────────────────────────
# SQLite database path. Defaults to ./data/secrets.db
SHH_DB_PATH=./data/secrets.db

# ─── API access ──────────────────────────────────────────────────────────
# Optional bearer tokens for the /api/v1 surface. Leave unset and the API is
# as open as the web form already is — the right default for a LAN-only
# instance. Set one or more (comma or whitespace separated) and every /api/v1
# route except /api/v1/info requires `Authorization: Bearer <token>`.
#
# Generate one with:  openssl rand -base64 32
#
# This does NOT gate the browser routes under /api/secrets; the web UI has
# nowhere to hide a token. To make the whole instance private, put auth in
# front of it (nginx basic auth, Tailscale, a VPN).
# SHH_API_TOKENS=

# Secrets a single IP may create per hour, across both the web form and the
# API. Set to 0 to disable the app-level limit (nginx still rate-limits /api).
# SHH_CREATE_RATE_LIMIT=60
